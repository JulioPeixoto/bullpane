// demo.bullpane.com — the public demo.
//
// One Worker in front of ONE container instance (see src/index.ts). The image
// (./Dockerfile, built from the repository root) holds the free edition in
// read-only mode plus its own Redis and simulator (SQLite, no database server), so nothing here
// touches any real data. Requires the Workers Paid plan.
{
  "name": "bullpane-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "demo.bullpane.com", "custom_domain": true }],
  "containers": [
    {
      "class_name": "BullpaneDemo",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB: app + Redis + simulator on SQLite. "lite" (256 MiB)
      // cannot hold two Node processes and Redis.
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DEMO", "class_name": "BullpaneDemo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BullpaneDemo"] }],
  "observability": { "enabled": true }
}
